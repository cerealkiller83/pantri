# ─── Required ──────────────────────────────────────────────────────────────────

# App base URL (used for magic link emails)
APP_URL=https://pantri.bydna.co

# Cookie session encryption key — generate with: openssl rand -hex 32
JWT_SECRET=

# MySQL/TiDB connection string — provided by Railway MySQL plugin
DATABASE_URL=

NODE_ENV=production

# ─── Email / Auth ───────────────────────────────────────────────────────────────

# Resend API key (resend.com — free tier: 3 000 emails/month)
RESEND_API_KEY=

# From address; must be a verified domain on Resend (add the DNS records Resend shows)
RESEND_FROM_EMAIL=pantri@bydna.co

# ─── Cloudflare R2 Storage ─────────────────────────────────────────────────────

# Cloudflare account ID (Cloudflare dashboard → top-right dropdown)
R2_ACCOUNT_ID=

# R2 API token Access Key ID and Secret (R2 → Manage R2 API Tokens → Create Token)
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=

# R2 bucket name (create in Cloudflare → R2 → Create bucket)
R2_BUCKET_NAME=pantri-prod

# Public URL for your R2 bucket.
# Option A: Enable public access on the bucket → copy the r2.dev URL (e.g. https://pub-xxx.r2.dev)
# Option B: Add a custom domain in R2 bucket settings (e.g. https://cdn.pantri.bydna.co)
R2_PUBLIC_URL=

# ─── Optional: Receipt OCR ─────────────────────────────────────────────────────

# OpenRouter API key — enables AI-powered receipt scanning
# Get one at openrouter.ai — the default model is openrouter/auto:free (no spend required)
OPENROUTER_API_KEY=

# ─── Optional: Web Push Notifications ─────────────────────────────────────────

# Generate with: npx web-push generate-vapid-keys
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=

# Must match VAPID_PUBLIC_KEY exactly — exposed to browser for push subscription
VITE_VAPID_PUBLIC_KEY=

# Your contact email, included in push requests per spec
VAPID_SUBJECT=mailto:damien@bydna.co

# ─── Optional: Scheduled Expiry Scan ──────────────────────────────────────────

# Random token securing POST /api/trpc/scheduled.scanExpiry
# Generate with: openssl rand -hex 32
# Set this in both your web service AND your cron service in Railway
SCHEDULED_TASK_TOKEN=
